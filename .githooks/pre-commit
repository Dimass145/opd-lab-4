#!/usr/bin/env python

import os
import subprocess
import sys

FORBIDDEN_DIRS = {
    "Saved",
    "Intermediate",
    "Binaries",
    "DerivedDataCache",
    ".vs",
}

MAX_FILE_SIZE = 50 * 1024 * 1024


def git(*args):
    return subprocess.check_output(["git", *args])


def get_staged_files():
    output = git(
        "diff",
        "--cached",
        "--name-only",
        "--diff-filter=ACMR",
        "-z"
    )
    return [path.decode("utf-8", errors="surrogateescape") for path in output.split(b"\0") if path]


def is_forbidden_path(path):
    return any(part in FORBIDDEN_DIRS for part in path.replace("\\", "/").split("/"))


def get_filter(path):
    output = git("check-attr", "filter", "--", path)
    return output.decode("utf-8", errors="replace").strip().split(": ")[-1]


def main():
    staged_files = get_staged_files()
    errors = []

    for path in staged_files:
        if is_forbidden_path(path):
            errors.append(f"Forbidden directory: {path}")
            continue

        if not os.path.isfile(path):
            continue

        size = os.path.getsize(path)

        if size > MAX_FILE_SIZE and get_filter(path) != "lfs":
            errors.append(
                f"File exceeds 50 MB and is not tracked by Git LFS: {path} ({size / (1024 * 1024):.2f} MB)"
            )

    if errors:
        print("Commit rejected:\n")
        for error in errors:
            print(f"  - {error}")

        print("\nPlease remove forbidden files or configure Git LFS.")
        sys.exit(1)


if __name__ == "__main__":
    main()